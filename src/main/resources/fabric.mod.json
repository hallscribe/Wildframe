{
	"schemaVersion": 1,
	"id": "wildframe",
	"version": "${version}",
	"name": "Wildframe",
	"description": "Wildframe is a mod that adds new items, blocks and tools to Minecraft.",
	"authors": [
		"hallscribe"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/wildframe",
		"sources": "https://github.com/hallscribe/wildframe",
		"issues": "https://github.com/hallscribe/wildframe/issues"
	},
	"license": "MIT",
	"icon": "assets/wildframe/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.hallscribe.wildframe.Wildframe"
		],
		"client": [
			"net.hallscribe.wildframe.WildframeClient"
		],
		"fabric-datagen": [
			"net.hallscribe.wildframe.WildframeDataGenerator"
		]
	},
	"accessWidener": "wildframe.accesswidener",
	"mixins": [
		"wildframe.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
